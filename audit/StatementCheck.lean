import Lean

/-!
# Comparing the project's types with the pinned propositions

`StatementCheck.checkPairs #[(projectConstant, pinnedProposition), …]`

For each pair:
1. Take the constant's type if it is a theorem, or its value if it is a `Prop` definition.
2. Unfold every definition whose module lies **outside** the import closure of `Mathlib` (i.e. the
   project's), and every elaborator-generated auxiliary proof `_proof_N`, up to a fixed point.
3. Compare with the pinned proposition (elaborated with Mathlib alone) in three ways:
   α-equivalence (`Expr.eqv`), strict equality (`Expr.equal`, including binder names and
   annotations), and definitional equality in the kernel (`Lean.Kernel.isDefEq`, on the original
   terms, independent of the unfolding done here).
4. Check that, after unfolding, no constant from outside Mathlib remains on either side.

A pair passes if the constant is neither an axiom nor `opaque`, is α-equivalent and kernel-defeq,
and no non-Mathlib constant remains. Otherwise an error is logged.
-/

open Lean Elab Command Meta

namespace StatementCheck

/-- Modules reachable from `root` through the imports recorded in the environment header. -/
def closure (env : Environment) (root : Name) : NameSet := Id.run do
  let names := env.header.moduleNames
  let data := env.header.moduleData
  let mut idx : Std.HashMap Name Nat := {}
  for i in [0:names.size] do
    idx := idx.insert names[i]! i
  let mut seen : NameSet := {}
  let mut stack : Array Name := #[root]
  while !stack.isEmpty do
    let m := stack.back!
    stack := stack.pop
    if seen.contains m then continue
    seen := seen.insert m
    if let some i := idx[m]? then
      for imp in data[i]!.imports do
        stack := stack.push imp.module
  return seen

/-- Auxiliary proof generated by the elaborator (`foo._proof_1`), e.g. for numerals. -/
def isAuxProof (c : Name) : Bool :=
  match c with
  | .str _ s => s.startsWith "_proof_"
  | _ => false

/-- Unfold definitions outside `inside` and all auxiliary proofs `_proof_N`, up to a fixed point.
Any other theorem, axiom or `opaque` of the project is left folded and is reported afterwards as a
non-Mathlib constant. -/
partial def unfoldOutside (env : Environment) (inside : Name → Bool) (e : Expr)
    (fuel : Nat := 64) : MetaM Expr := do
  if fuel == 0 then return e
  let e' := e.replace fun sub =>
    match sub with
    | .const c us =>
      match env.find? c with
      | some (.thmInfo t) =>
        -- Auxiliary proofs are always unfolded (Mathlib's too): their names depend on the
        -- module that generated them.
        if isAuxProof c then some (t.value.instantiateLevelParams t.levelParams us) else none
      | some (.defnInfo d) =>
        if inside c then none else some (d.value.instantiateLevelParams d.levelParams us)
      | _ => none
    | _ => none
  let e' ← Core.betaReduce e'
  if e' == e then return e else unfoldOutside env inside e' (fuel - 1)

def checkPairs (pairs : Array (Name × Name)) : CommandElabM Unit := do
  let env ← getEnv
  let mathlib := closure env `Mathlib
  let modOf (c : Name) : Option Name :=
    (env.getModuleIdxFor? c).map fun i => env.header.moduleNames[i.toNat]!
  let inside (c : Name) : Bool :=
    match modOf c with
    | some m => mathlib.contains m
    | none => false
  logInfo m!"Mathlib import closure: {mathlib.size} of {env.header.moduleNames.size} modules"
  let mut failures := 0
  for (proj, pinnedName) in pairs do
    let some pinfo := env.find? proj | throwError "Unknown constant {proj}"
    let some (.defnInfo finfo) := env.find? pinnedName
      | throwError "{pinnedName} is not a definition"
    let (kind, target) := match pinfo with
      | .defnInfo d => ("def", d.value)
      | .thmInfo t => ("theorem", t.type)
      | .axiomInfo a => ("AXIOM", a.type)
      | .opaqueInfo o => ("OPAQUE", o.type)
      | other => ("other", other.type)
    let unfolded ← liftTermElabM <| unfoldOutside env inside target
    let pinned ← liftTermElabM <| unfoldOutside env inside finfo.value
    let alpha := unfolded == pinned
    let strict := unfolded.equal pinned
    let kernel := match Kernel.isDefEq env {} target finfo.value with
      | .ok b => b
      | .error _ => false
    let foreignProj := unfolded.getUsedConstants.filter (! inside ·)
    let foreignPinned := pinned.getUsedConstants.filter (! inside ·)
    let ok := (kind == "def" || kind == "theorem") && alpha && kernel
      && foreignProj.isEmpty && foreignPinned.isEmpty
    logInfo m!"{if ok then "PASS" else "FAIL"} {proj} [{kind}, module {modOf proj}] vs \
      {pinnedName}\n  alpha-equivalent: {alpha} · strictly equal: {strict} · kernel defeq: \
      {kernel}\n  non-Mathlib constants after unfolding: {foreignProj} / {foreignPinned}\n  \
      unfolded type: {unfolded}"
    unless ok do failures := failures + 1
  if failures > 0 then
    logError m!"{failures} of {pairs.size} checks failed"
  else
    logInfo m!"All {pairs.size} checks passed"

/-- Fail if a constant depends on axioms other than propext, Classical.choice and Quot.sound. -/
def checkAxioms (names : Array Name) : CommandElabM Unit := do
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  for n in names do
    let axs ← liftCoreM <| collectAxioms n
    let bad := axs.filter (! allowed.contains ·)
    if bad.isEmpty then logInfo m!"axioms of {n}: {axs}"
    else logError m!"{n} depends on disallowed axioms: {bad}"

end StatementCheck
